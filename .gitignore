.gradle/
.kotlin/
build/
out/
*.class
*.log
hs_err_pid*
replay_pid*

# --- Release artifacts (publish them under GitHub Releases, not in the repo) -
*.zip
*.7z
*.rar
*.exe
*.msi
*.dmg
*.deb
*.rpm
*.AppImage
*.crx
*.xpi
*.jar
