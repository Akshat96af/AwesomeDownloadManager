# --- IDEs and editors ---------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.vs/
.fleet/
*.swp
*~

# --- Operating system files --------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Local machine settings ----------------------------------------------------
local.properties
.env
.env.*

# --- Secrets: signing keys and keystores must never be public ---------------
# (the extension's public key lives in browser-extension/manifest.json)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# --- Tooling installed per machine ---------------------------------------------
node_modules/
