{
  "manifest_version": 3,
  "name": "Absolute Download Manager",
  "version": "1.0.0",
  "description": "Send downloads, links and page videos from your browser to Absolute Download Manager.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "webRequest",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Absolute Download Manager",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-page.js"
      ],
      "world": "MAIN",
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
